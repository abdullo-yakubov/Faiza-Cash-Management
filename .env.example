# Copy to .env.docker. Use your own random secrets.
POSTGRES_PASSWORD=
JWT__KEY=
SEED__ADMINLOGIN=admin
SEED__ADMINPASSWORD=
# Backup encryption (AES-256-GCM): base64 of 32 random bytes, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Keep a copy outside the server: without it encrypted backups cannot be restored.
BACKUPS__ENCRYPTIONKEY=
