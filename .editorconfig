# EditorConfig FAIZA GOLD — https://editorconfig.org
# Общие правила для всех редакторов (VS, VS Code, Rider) и для `dotnet format`.
# Переформатирование существующего кода этими правилами НЕ выполнялось:
# в CI проверка работает в режиме предупреждения (см. .github/workflows/verify.yml).
root = true

# ---------- Общие правила ----------
[*]
charset = utf-8
# LF во всём репозитории: CI и контейнеры работают на Linux, а Git на Windows
# при core.autocrlf=true всё равно хранит LF. Единый LF убирает «шумные» диффы
# и ложные срабатывания `dotnet format` в CI. Подробности — REPORT-C.md.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Скрипты Windows обязаны иметь CRLF
[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
# Два пробела в конце строки — перенос строки в Markdown
trim_trailing_whitespace = false

[*.{json,yml,yaml,js,jsx,mjs,css,html}]
indent_size = 2

[*.{csproj,props,targets,sln,xml,config}]
indent_size = 2

[*.sql]
indent_size = 2

# ---------- C# ----------
[*.cs]
indent_size = 4
max_line_length = 160

# Пространства имён и using
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# var: используем, когда тип очевиден из правой части
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Современный синтаксис
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_lambdas = true:silent
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_prefer_braces = when_multiline:silent
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# Модификаторы доступа
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# ---------- Именование ----------
# Интерфейсы: IName
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i_style
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Типы, методы, свойства, события, константы: PascalCase
dotnet_naming_rule.types_and_members_pascal.symbols = pascal_symbols
dotnet_naming_rule.types_and_members_pascal.style = pascal_style
dotnet_naming_rule.types_and_members_pascal.severity = warning
dotnet_naming_symbols.pascal_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event, namespace
dotnet_naming_style.pascal_style.capitalization = pascal_case

dotnet_naming_rule.constants_pascal.symbols = constant_symbols
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_rule.constants_pascal.severity = suggestion
dotnet_naming_symbols.constant_symbols.applicable_kinds = field, local
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# Приватные поля: _camelCase (рекомендация; в коде преобладают primary constructors)
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# Параметры и локальные переменные: camelCase
dotnet_naming_rule.locals_camel.symbols = local_symbols
dotnet_naming_rule.locals_camel.style = camel_style
dotnet_naming_rule.locals_camel.severity = suggestion
dotnet_naming_symbols.local_symbols.applicable_kinds = parameter, local
dotnet_naming_style.camel_style.capitalization = camel_case

# ---------- Анализаторы: уровни важности ----------
# Реальные ошибки — warning; стилистика — suggestion, чтобы не блокировать сборку.
dotnet_diagnostic.CA2007.severity = none        # ConfigureAwait — не нужен в ASP.NET Core
dotnet_diagnostic.CA1848.severity = suggestion  # LoggerMessage delegates
dotnet_diagnostic.CA1305.severity = warning     # IFormatProvider: деньги и даты — только InvariantCulture
dotnet_diagnostic.CA1307.severity = suggestion  # StringComparison
dotnet_diagnostic.CA2100.severity = warning     # SQL из строк — только интерполированные параметры
dotnet_diagnostic.CA5394.severity = warning     # небезопасный Random
dotnet_diagnostic.CA2016.severity = warning     # передавать CancellationToken
dotnet_diagnostic.IDE0005.severity = suggestion # лишние using
dotnet_diagnostic.IDE0161.severity = warning    # file-scoped namespace
dotnet_diagnostic.CS1591.severity = none        # XML-комментарии не обязательны

# Сгенерированный код миграций EF Core не форматируем и не анализируем
# (файлы создаются инструментом с BOM; миграции не редактируются задним числом).
[backend/src/**/Migrations/*.cs]
generated_code = true
charset = unset
dotnet_analyzer_diagnostic.severity = none
